generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  walletAddress String     @unique
  fcmToken      String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  positions     Position[]
  alertLogs     AlertLog[]
}

model Position {
  id                 String        @id @default(uuid())
  userId             String
  positionId         String        // dYdX internal position id
  marketId           String        // e.g. BTC-USD
  subaccountNumber   Int           @default(0) // dYdX subaccount number (0=CROSS, >=128=ISOLATED)
  side               PositionSide  // LONG or SHORT
  size               Decimal       @db.Decimal(30, 10)
  entryPrice         Decimal       @db.Decimal(30, 10)
  liquidationPrice   Decimal       @db.Decimal(30, 10)
  oraclePrice        Decimal       @db.Decimal(30, 10)
  margin             Decimal       @db.Decimal(30, 10)
  status             PositionStatus @default(OPEN)
  lastCheckedAt      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id])
  alertLogs          AlertLog[]

  @@unique([userId, positionId])
  @@index([marketId, liquidationPrice])
}

model AlertLog {
  id           String    @id @default(uuid())
  userId       String
  positionId   String
  alertType    AlertType
  distancePct  Decimal   @db.Decimal(10, 4)
  oraclePrice  Decimal   @db.Decimal(30, 10)
  liqPrice     Decimal   @db.Decimal(30, 10)
  sentAt       DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])
  position     Position  @relation(fields: [userId, positionId], references: [userId, positionId])
}

enum PositionSide   {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum AlertType      {
  WARNING
  DANGER
  CRITICAL
}

model positions_snapshot {
  id                Int      @id @default(autoincrement())
  address           String
  subaccount_number Int
  market            String
  side              String
  signed_size       Decimal  @db.Decimal(30, 10)
  entry_price       Decimal  @db.Decimal(30, 10)
  liq_price         Decimal? @db.Decimal(30, 10)
  oracle_price      Decimal? @db.Decimal(30, 10)
  distance_pct      Decimal? @db.Decimal(10, 4)
  margin_type       String
  updated_at        DateTime @default(now()) @db.Timestamptz

  @@unique([address, subaccount_number, market])
  @@index([address, market])
  @@index([address])
}

model alert_log {
  id                Int      @id @default(autoincrement())
  address           String
  subaccount_number Int
  market            String
  level             String
  liq_price         Decimal? @db.Decimal(30, 10)
  oracle_price      Decimal? @db.Decimal(30, 10)
  distance_pct      Decimal? @db.Decimal(10, 4)
  margin_type       String
  fired_at          DateTime @default(now()) @db.Timestamptz

  @@index([address, fired_at(sort: Desc)])
}

